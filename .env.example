# PostgreSQL connection — replace with your own instance's details
PG_HOST=your-db-host.example.com
PG_PORT=5432
PG_DATABASE=learngate
PG_USERNAME=your_db_user
PG_PASSWORD=
# 'require' | 'prefer' | 'false' (string) — disable only for trusted private networks
PG_SSL=prefer

# Long random secret used to sign/verify session JWTs
JWT_SECRET=

# Key required to access the /api/dev/* support endpoints
DEV_KEY=

# Optional extra Origin to allow in CORS, beyond the built-in same-origin check
# (rarely needed — same-origin requests are always allowed automatically)
EXTRA_ALLOWED_ORIGIN=

# Port the Express server listens on
PORT=3000

# SendPulse WhatsApp Business API — required for every /api/sendpulse/*
# endpoint (student issue notifications, ticket alerts, broadcasts). Without
# these, getSendPulseToken() throws "SendPulse auth failed" and every
# WhatsApp send fails. Get client_id/client_secret from SendPulse's API
# settings and the bot_id from the WhatsApp bot's own settings page.
SENDPULSE_ID=
SENDPULSE_SECRET=
SENDPULSE_BOT_ID=
